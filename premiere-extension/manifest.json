{
  "id": "com.bijoumusic.premiere-bridge",
  "name": "BijouMusic Bridge",
  "shortname": "bijoumusic",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": ["http://localhost:8934", "ws://localhost:8934"]
    }
  },
  "entrypoints": [
    {
      "id": "bridgePanel",
      "type": "panel",
      "minimumSize": { "width": 260, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 320 },
      "preferredFloatingSize": { "width": 280, "height": 320 },
      "label": {
        "default": "BijouMusic"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
